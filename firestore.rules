rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ["REPLACE_WITH_ADMIN_EMAIL"];}
  match /products/{productId} { allow read: if resource.data.active != false; allow create, update, delete: if isAdmin(); }
 }
}
