rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && request.auth.uid == "5KgMz6p7RKeD75aSzaaan4Yodyb2" && request.auth.token.email_verified == true;}
  match /products/{productId} { allow read: if resource.data.active != false || isAdmin(); allow create, update, delete: if isAdmin(); }
 }
}
