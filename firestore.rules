rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ["admin@amcinfotech.com"];}
  match /products/{productId} { allow read: if resource.data.active != false || isAdmin(); allow create, update, delete: if isAdmin(); }
 }
}
