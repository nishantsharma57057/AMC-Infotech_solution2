rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          (
            request.auth.uid == "5KgMz6p7RKeD75aSzaaan4Yodyb2"
            && request.auth.token.email == "admin@amcinfotech.com"
          )
          ||
          (
            request.auth.uid == "nyD7LWscXQQV7cYkuSnx7qcRktF3"
            && request.auth.token.email == "nishantsharma57057@gmail.com"
          )
        );
    }

    match /products/{productId} {
      // Public visitors can read only published products.
      // Verified AMC admins can read the complete inventory.
      allow get, list: if isAdmin() || resource.data.active == true;

      // Only verified AMC admins can create, edit, publish, hide or delete products.
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      // The public website reads only its single public business-profile document.
      allow get: if settingId == "public";
      allow list: if isAdmin();
      // Only verified AMC admins can update business contact and social details.
      allow create, update, delete: if isAdmin();
    }
  }
}